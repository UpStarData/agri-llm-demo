# 农链 AgriLink 本地演示服务 —— 环境变量样例
# 复制为 .env 后按需填写：cp .env.example .env
# ⚠️ .env 已在 .gitignore 中；绝对不要把真实 key 写进源码 / 前端 / commit / 日志 / 截图。
#     前端 bundle（index.html）与 GitHub Pages 静态版不含任何 key；key 只在服务端进程内存里。
#
# 其实**不填任何 key 也能用**：服务端会自动只读复用本机已有的 pi 配置
# （~/.pi/agent/models-store.json + auth.json），不改动原配置。想关掉这个自动回退就设
# AGRI_NO_IMPORT=1。

# 本地服务端口（默认 4173；启停脚本 serve.sh 用 4180）
PORT=4173

# 只监听哪个地址。默认 127.0.0.1 —— 配置 API（含写 key）不暴露到局域网。
# 确实要局域网访问才改成 0.0.0.0（此时配置页只应由可信网络访问）。
# AGRI_BIND=127.0.0.1

# OpenAI-compatible 上游 baseURL（不要带结尾斜杠，不要带 /chat/completions）
# DeepSeek 云端：https://api.deepseek.com   （本机 pi 配置里就是这个）
# LM Studio 局域网：http://127.0.0.1:1234/v1  或  http://<局域网IP>:1234/v1
AGRI_LLM_BASE_URL=https://api.deepseek.com

# 模型名（DeepSeek：deepseek-flash / deepseek-v4-pro / deepseek-chat；LM Studio：用 GET /v1/models 返回的 id）
AGRI_LLM_MODEL=deepseek-flash

# 模型凭证 —— 只写变量名在这里，值请填进本机 .env 或 shell 环境变量
# 注意：环境变量的优先级高于本机配置文件（~/.agrilink/ai-config.json）；
#       若这里设了 key，配置页里保存的新 key 只有移除该环境变量后才生效（配置页会显式提示）。
# AGRI_LLM_API_KEY=sk-REPLACE_ME
# LM Studio 用自己的变量名也可以：LM_API_TOKEN=REPLACE_ME

# 也可以指向一个本机已有的凭证文件（只读第一行，不进日志、不回传前端）
# AGRI_LLM_KEY_FILE=/absolute/path/to/your/keyfile

# 关掉「只读导入本机 pi / LM Studio 配置」的自动回退（测试与确定性部署时用）
# AGRI_NO_IMPORT=1

# 配置文件的落盘位置（默认 ~/.agrilink/ai-config.json；由「AI 配置」页写入，权限 0600）
# AGRI_CONFIG_FILE=/absolute/path/to/ai-config.json

# 超时（毫秒）：对话请求 / 启动时的 /models 校验
AGRI_LLM_TIMEOUT_MS=60000
AGRI_LLM_VERIFY_TIMEOUT_MS=4000

# 生成参数（默认 4096 / 0.3）。DeepSeek 这类带推理的模型：
# max_tokens 太小会把额度都花在 reasoning_content 上，正文会是空的 ——
# 服务端检测到这种情况会返回明确错误（而不是假装成功），把「最大输出长度」调大即可。
# AGRI_LLM_MAX_TOKENS=4096
# AGRI_LLM_TEMPERATURE=0.3
