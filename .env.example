# 农链 AgriLink 本地演示服务 —— 环境变量样例
# 复制为 .env 后按需填写：cp .env.example .env
# ⚠️ .env 已在 .gitignore 中；绝对不要把真实 key 写进源码 / 前端 / commit / 日志 / 截图。
#     前端 bundle（index.html）与 GitHub Pages 静态版不含任何 key；key 只在服务端进程内存里。

# 本地服务端口（默认 4173）
PORT=4173

# OpenAI-compatible 上游 baseURL（不要带结尾斜杠，不要带 /chat/completions）
# DeepSeek 云端：https://api.deepseek.com/v1
# LM Studio 局域网：http://127.0.0.1:1234/v1  或  http://<局域网IP>:1234/v1
AGRI_LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名（DeepSeek：deepseek-chat / deepseek-reasoner；LM Studio：用 GET /v1/models 返回的 id）
AGRI_LLM_MODEL=deepseek-chat

# 模型凭证 —— 只写变量名在这里，值请填进本机 .env 或 shell 环境变量
# AGRI_LLM_API_KEY=sk-REPLACE_ME
# LM Studio 用自己的变量名也可以：LM_API_TOKEN=REPLACE_ME

# 也可以指向一个本机已有的凭证文件（只读第一行，不进日志、不回传前端）
# AGRI_LLM_KEY_FILE=/absolute/path/to/your/keyfile

# 超时（毫秒）：对话请求 / 启动时的 /models 校验
AGRI_LLM_TIMEOUT_MS=60000
AGRI_LLM_VERIFY_TIMEOUT_MS=4000
